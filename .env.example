# PayPal Sandbox REST app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: enables webhook signature verification
PAYPAL_WEBHOOK_ID=
# Optional: enables Claude drafting and analysis (rule-based fallback works without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=3000

# Optional shared private-demo gate. Use a unique random value of 32+ characters.
PAYGUARD_ACCESS_KEY=
# Set true to fail closed if the access key is missing (Cloudflare production default).
PAYGUARD_REQUIRE_ACCESS_KEY=false
